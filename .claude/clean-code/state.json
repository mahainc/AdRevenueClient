  "verdicts": {
    "G14:Sources/AdRevenueClientLive/AdRevenueClient+Funnel.swift:12566065": {
      "evidence": "funnelEvent is a field-by-field mapper from AdRevenueClient.Event to the FunnelClient port type; reading the source event's fields is its whole job, and the port type cannot own a conversion from this package (FunnelClient must not depend on AdRevenueClient)",
      "unit_sha": "886d75a3",
      "code": "G14",
      "mark": "7e82b395:60609d45",
      "confirmed": false,
      "review": "funnelEvent only reads AdRevenueClient.Event's own fields to build the FunnelClient DTO, and FunnelClient's port type cannot depend back on AdRevenueClient, so the conversion has nowhere else to live"
    },
    "G10:Tests/AdRevenueClientTests/AdRevenueClientTests.swift:17139041": {
      "evidence": "mapped must be created before the source yields so the mapping stream exists; it is the subject under test, declared at arrange, consumed at act (Arrange-Act-Assert)",
      "unit_sha": "1d6a5bb7",
      "code": "G10",
      "mark": "9a15761d:60609d45",
      "confirmed": false,
      "review": "`mapped` is the subject under test and must be declared before the continuation yields, which is exactly arrange-before-act, not a hidden ordering bug"
    },
    "G30:Tests/AdRevenueClientTests/AdRevenueClientTests.swift:8ae1e6b3": {
      "evidence": "one test of one behavior (the Funnel mapping); length is the fixture with 8 fields plus one #expect per mapped field",
