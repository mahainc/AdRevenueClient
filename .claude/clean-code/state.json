  "verdicts": {
    "G14:Sources/AdRevenueClientLive/AdRevenueClient+Funnel.swift:12566065": {
      "evidence": "funnelEvent is a field-by-field mapper from the client's event to the port's event; reading the source seven times is the whole job, and the port type lives in FunnelClient so the mapping cannot move onto either struct",
      "unit_sha": "5e07f4cc",
      "code": "G14",
      "mark": "7e82b395:ca66bf58",
      "confirmed": true,
      "review": "funnelEvent's target type lives in FunnelClient and can't own the conversion, so the seven field reads are a boundary mapper's whole job, not feature envy"
    },
    "G18:Sources/AdRevenueClientLive/AdRevenueClient+Funnel.swift:fc2d852a": {
      "evidence": "AdFormat lives in the FunnelClient-free interface target; putting the funnel's 'resume' naming there as an instance property would leak funnel vocabulary into a package that must stay usable without FunnelClient",
      "unit_sha": "a9083f8f",
      "code": "G18",
      "mark": "5c05eb35:ca66bf58",
      "confirmed": true,
      "review": "AdFormat is declared in the FunnelClient-free interface target, so the funnel-specific \"resume\" naming can only live as a static translation in Live, not as an instance member on AdFormat itself"
    },
    "N1:Tests/AdRevenueClientTests/AdRevenueClientTests.swift:01edc6f4": {
      "evidence": "pre-existing test line, untouched; 'data' is the JSONEncoder output in a 3-line codable round-trip",
      "unit_sha": "ebadbfba",
      "code": "N1",
      "mark": "0f98b60e:ca66bf58",
      "confirmed": true,
      "review": "the local is the raw JSONEncoder output in a 3-line encode/decode round-trip, a scope too short to need a more specific name"
    },
    "G5:Tests/AdRevenueClientTests/AdRevenueClientTests.swift:4619f92b": {
      "evidence": "each test builds its own single-use source stream; sharing it across tests would couple their lifetimes",
      "unit_sha": "5b19359e",
      "code": "G5",
      "mark": "182d7b3d:ca66bf58",
      "confirmed": true,
      "review": "each Funnel-conformance test builds its own single-use AsyncStream/continuation pair, and sharing one across tests would couple otherwise-independent test lifetimes"
    }
  },
